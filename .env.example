# Salin berkas ini menjadi .env.local lalu isi nilainya.
# Nilai asli TIDAK boleh dicommit ke repositori.

# Alamat proyek Supabase, contoh: https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Kunci publik (publishable / anon). Aman dipakai di browser karena
# dibatasi Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Kunci rahasia (service role / secret). HANYA dipakai di sisi server.
# Jangan pernah menaruhnya di variabel berawalan NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# String koneksi PostgreSQL. Dipakai hanya oleh skrip migrasi lokal
# (npm run db:setup), tidak dibutuhkan saat aplikasi berjalan di Vercel.
SUPABASE_DB_URL=

# Alamat situs, dipakai untuk tautan verifikasi email, sitemap, dan
# pesan WhatsApp. Di Vercel isi dengan domain produksi.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sakelar fitur keamanan tambahan. Isi `on` untuk menyalakan.
# Keduanya dimatikan bila dikosongkan atau diisi nilai lain.
#   FITUR_OTP_PELANGGAN=on  -> pendaftaran pelanggan wajib verifikasi email
#   FITUR_2FA_ADMIN=on      -> admin wajib memakai aplikasi autentikator
FITUR_OTP_PELANGGAN=off
FITUR_2FA_ADMIN=off
